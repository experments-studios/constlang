{
  "name": "constlang",
  "version": "7.0.0",
  "description": "Constlang Programming Language v7.0",
  "author": "Ilkin Yahya <theprocramer@gmail.com>",
  "homepage": "https://constlang.pages.dev",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pckwin": "electron-builder --win",
    "pcklin": "electron-builder --linux"
